{
  "name": "sts-peter-paul-kiambu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:cf": "bun run build && wrangler dev",
    "deploy:cf": "bun run build && wrangler deploy",
    "deploy:cf:dry": "bun run build && wrangler deploy --dry-run",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run"
  },
  "vercel": {
    "buildCommand": "bun run build",
    "outputDirectory": "dist",
    "installCommand": "bun install --frozen-lockfile"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.13.2",
    "@phosphor-icons/react": "^2.1.10",
    "@stripe/react-stripe-js": "^3.5.1",
    "@stripe/stripe-js": "^2.4.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^6.0.2",
    "dompurify": "^3.4.11",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  }
}
